# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Leave VITE_FIREBASE_API_KEY empty to run against the local Firebase emulators (demo-potluck).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public URL of the web build (Firebase Hosting). Invite links point here so
# guests can join in a browser; Android App Links open the app instead when installed.
VITE_PUBLIC_WEB_URL=https://YOUR-PROJECT.web.app

# Where "Get the Android app" sends people (Play Store listing or hosted APK).
VITE_ANDROID_APP_URL=/download/potluck-showdown.apk

# Where the app finds the local Firebase emulators when VITE_FIREBASE_API_KEY is empty.
# Leave blank to auto-detect: 10.0.2.2 in the Android Studio emulator, 127.0.0.1 in a browser.
# (To test on a physical phone, set this to your computer's Wi-Fi IP address.)
VITE_EMULATOR_HOST=
