# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Leave EXPO_PUBLIC_FIREBASE_API_KEY empty to run against the local Firebase emulators (demo-potluck).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public URL of the web build (Firebase Hosting). Invite links point here so
# guests can join in a browser. Leave blank while testing in Expo Go: invite
# links then open the app directly (exp://… links other Expo Go testers can tap).
EXPO_PUBLIC_WEB_URL=

# Optional: where "Get the Android app" (shown to Android browser visitors) sends people.
EXPO_PUBLIC_ANDROID_APP_URL=

# Where the app finds the local Firebase emulators when EXPO_PUBLIC_FIREBASE_API_KEY is empty.
# Leave blank to auto-detect: Expo Go uses the address of the computer running `npm start`.
EXPO_PUBLIC_EMULATOR_HOST=
