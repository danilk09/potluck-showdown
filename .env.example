# Convex cloud deployment URL
EXPO_PUBLIC_CONVEX_URL=https://compassionate-starfish-134.convex.cloud

# Optional: where "Get the Android app" (shown to Android browser visitors) sends people.
EXPO_PUBLIC_ANDROID_APP_URL=

# Public URL of the hosted web build. Invite links point here, and `npm run build:web`
# uses it for the picture on invite link previews (iMessage, WhatsApp, Discord…).
EXPO_PUBLIC_WEB_URL=
