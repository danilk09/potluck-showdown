{
  "name": "potluck-showdown",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint src tests -D correctness --react-plugin",
    "test": "vitest run tests/unit",
    "test:rules": "node scripts/firebase.mjs emulators:exec --config firebase.rules-test.json --only firestore --project demo-potluck \"vitest run tests/rules\"",
    "emulators": "node scripts/emulators.mjs",
    "emulators:save": "node scripts/firebase.mjs emulators:export .emulator-data --project demo-potluck --force",
    "seed": "node scripts/seed.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:web": "expo export --platform web",
    "deploy:web": "expo export --platform web && node scripts/firebase.mjs deploy --only hosting",
    "deploy:rules": "node scripts/firebase.mjs deploy --only firestore"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.30",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^13.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.33.0",
    "oxlint": "^1.87.0",
    "sharp": "^0.35.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
