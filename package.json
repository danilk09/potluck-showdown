{
  "name": "potluck-showdown",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint src tests -D correctness --react-plugin",
    "test": "vitest run tests/unit",
    "test:rules": "node scripts/firebase.mjs emulators:exec --config firebase.rules-test.json --only firestore --project demo-potluck \"vitest run tests/rules\"",
    "emulators": "node scripts/emulators.mjs",
    "emulators:save": "node scripts/firebase.mjs emulators:export .emulator-data --project demo-potluck --force",
    "seed": "node scripts/seed.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:web": "expo export --platform web",
    "deploy:web": "expo export --platform web && node scripts/firebase.mjs deploy --only hosting",
    "deploy:rules": "node scripts/firebase.mjs deploy --only firestore"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "convex": "^1.48.0",
    "expo": "~58.0.0",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "firebase": "^13.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.33.0",
    "oxlint": "^1.87.0",
    "sharp": "^0.35.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
